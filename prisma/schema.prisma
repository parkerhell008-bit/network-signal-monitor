generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// نتیجهٔ هر تست سرعت برای نمایش تاریخچه و نمودار
model SpeedTestResult {
  id             String   @id @default(cuid())
  downloadMbps   Float
  uploadMbps     Float
  pingMs         Float
  jitterMs       Float
  connectionType String? // نوع اتصال: wifi / cellular / ethernet
  effectiveType  String? // 2g / 3g / 4g / slow-2g
  qualityScore   Int? // امتیاز کیفیت سیگنال 0..100
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
