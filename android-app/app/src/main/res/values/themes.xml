<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.NetSignal" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/emerald</item>
        <item name="colorOnPrimary">@color/chip_text</item>
        <item name="colorPrimaryContainer">@color/surface</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/emerald</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>

    <!-- عنوان کارت‌ها -->
    <style name="CardTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- برچسب سمت راستِ ردیف‌های «برچسب / مقدار» -->
    <style name="RowLabel">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- مقدار سمت چپِ ردیف‌های «برچسب / مقدار» -->
    <style name="RowValue">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- مقدار بزرگ (فاصله تا دکل) -->
    <style name="BigValue">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/emerald</item>
    </style>

</resources>
