<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- ═══════════ سربرگ ═══════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/app_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnShare"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/share_via"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_share"
                    app:tint="@color/emerald" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPermissionGate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/surface"
                android:padding="12dp"
                android:text="@string/permission_gate"
                android:textColor="@color/sig_mid"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- ═══════════ کارت وضعیت سیگنال و شبکه ═══════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout style="@style/CardHeader">

                        <androidx.appcompat.widget.AppCompatImageView
                            style="@style/CardIcon"
                            app:srcCompat="@drawable/ic_signal" />

                        <TextView
                            style="@style/CardTitle"
                            android:text="@string/card_status_title" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ir.netsignal.monitor.SignalGaugeView
                            android:id="@+id/gaugeView"
                            android:layout_width="0dp"
                            android:layout_height="210dp"
                            android:layout_weight="1.1" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ir.netsignal.monitor.SignalBarsView
                                android:id="@+id/barsView"
                                android:layout_width="match_parent"
                                android:layout_height="46dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipNetwork"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:checkable="false"
                                android:text="@string/no_data"
                                android:textColor="@color/chip_text"
                                android:textStyle="bold"
                                app:chipBackgroundColor="@color/emerald"
                                app:chipStrokeWidth="0dp" />

                            <TextView
                                android:id="@+id/tvSignalScore"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/no_data"
                                android:textAlignment="center"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <ir.netsignal.monitor.SignalChartView
                        android:id="@+id/signalChart"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:layout_marginTop="10dp" />

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_operator" />
                        <TextView
                            android:id="@+id/tvOperatorName"
                            style="@style/RowValue"
                            tools:text="همراه اول" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_sim_operator" />
                        <TextView
                            android:id="@+id/tvSimOperator"
                            style="@style/RowValue"
                            tools:text="IR-MCI" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_sim_state" />
                        <TextView
                            android:id="@+id/tvSimState"
                            style="@style/RowValue"
                            tools:text="آماده" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_country" />
                        <TextView
                            android:id="@+id/tvCountryIso"
                            style="@style/RowValue"
                            tools:text="IR" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_roaming" />
                        <TextView
                            android:id="@+id/tvRoaming"
                            style="@style/RowValue"
                            tools:text="غیرفعال (شبکه داخلی)" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_data_state" />
                        <TextView
                            android:id="@+id/tvDataState"
                            style="@style/RowValue"
                            tools:text="متصل" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_data_activity" />
                        <TextView
                            android:id="@+id/tvDataActivity"
                            style="@style/RowValue"
                            tools:text="ارسال و دریافت" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_modems" />
                        <TextView
                            android:id="@+id/tvPhoneCount"
                            style="@style/RowValue"
                            tools:text="۲" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════ کارت دکل متصل و سلول‌های اطراف ═══════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout style="@style/CardHeader">

                        <androidx.appcompat.widget.AppCompatImageView
                            style="@style/CardIcon"
                            app:srcCompat="@drawable/ic_tower" />

                        <TextView
                            style="@style/CardTitle"
                            android:text="@string/card_tower_title" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_rat" />
                        <TextView
                            android:id="@+id/tvServingRat"
                            style="@style/RowValue"
                            tools:text="4G – LTE" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_pci" />
                        <TextView
                            android:id="@+id/tvServingPci"
                            style="@style/RowValue"
                            tools:text="۲۳۱" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_cid" />
                        <TextView
                            android:id="@+id/tvServingCid"
                            style="@style/RowValue"
                            tools:text="۲۲۴۴۵۵" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_tac" />
                        <TextView
                            android:id="@+id/tvServingTac"
                            style="@style/RowValue"
                            tools:text="۳۲۱" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_earfcn" />
                        <TextView
                            android:id="@+id/tvServingEarfcn"
                            style="@style/RowValue"
                            tools:text="۱۳۰۰" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_mccmnc" />
                        <TextView
                            android:id="@+id/tvServingMccMnc"
                            style="@style/RowValue"
                            tools:text="432 – 11" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_bandwidth" />
                        <TextView
                            android:id="@+id/tvServingBandwidth"
                            style="@style/RowValue"
                            tools:text="۲۰ مگاهرتز" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/neighbors_title"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerCells"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_cell" />

                    <TextView
                        android:id="@+id/tvNoCells"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/no_cells"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════ کارت فاصله تا دکل (خودکار) ═══════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout style="@style/CardHeader">

                        <androidx.appcompat.widget.AppCompatImageView
                            style="@style/CardIcon"
                            app:srcCompat="@drawable/ic_tower" />

                        <TextView
                            style="@style/CardTitle"
                            android:text="@string/card_distance_title" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTowerDistance"
                        style="@style/BigValue"
                        android:layout_marginTop="14dp"
                        android:text="@string/distance_na"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvDistanceSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/distance_na"
                        android:textAlignment="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tvDistanceAcc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAlignment="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLocateTower"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/btn_locate"
                        android:textColor="@color/chip_text"
                        app:backgroundTint="@color/emerald" />

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_bearing" />
                        <TextView
                            android:id="@+id/tvTowerBearing"
                            style="@style/RowValue"
                            tools:text="شمال‌شرقی (۴۵ درجه)" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_gps" />
                        <TextView
                            android:id="@+id/tvGpsCoords"
                            style="@style/RowValue"
                            tools:text="35.74480, 51.37530" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAdvancedToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="10dp"
                        android:text="@string/advanced_toggle_show"
                        android:textAlignment="center"
                        android:textColor="@color/emerald"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/llAdvanced"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilApiKey"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:hint="@string/hint_api_key"
                            app:boxStrokeColor="@color/emerald"
                            app:hintTextColor="@color/emerald">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etApiKey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/btn_save_key"
                            android:textColor="@color/chip_text"
                            app:backgroundTint="@color/emerald" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════ کارت سیم‌کارت‌ها (Dual SIM) ═══════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout style="@style/CardHeader">

                        <androidx.appcompat.widget.AppCompatImageView
                            style="@style/CardIcon"
                            app:srcCompat="@drawable/ic_sim" />

                        <TextView
                            style="@style/CardTitle"
                            android:text="@string/card_sim_title" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSimCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/no_data"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/llSimList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════ کارت تست سرعت اینترنت ═══════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout style="@style/CardHeader">

                        <androidx.appcompat.widget.AppCompatImageView
                            style="@style/CardIcon"
                            app:srcCompat="@drawable/ic_speed" />

                        <TextView
                            style="@style/CardTitle"
                            android:text="@string/card_speed_title" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSpeedTest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/btn_start_speed"
                        android:textColor="@color/chip_text"
                        app:backgroundTint="@color/emerald" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progress="0"
                        app:indicatorColor="@color/emerald"
                        app:trackColor="@color/gauge_track"
                        app:trackCornerRadius="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/MiniPanel">
                            <TextView
                                style="@style/MiniPanelLabel"
                                android:text="@string/label_ping" />
                            <TextView
                                android:id="@+id/tvPing"
                                style="@style/MiniPanelValue"
                                android:text="@string/speed_na" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/MiniPanel"
                            android:layout_marginStart="8dp">
                            <TextView
                                style="@style/MiniPanelLabel"
                                android:text="@string/label_download" />
                            <TextView
                                android:id="@+id/tvDownload"
                                style="@style/MiniPanelValue"
                                android:text="@string/speed_na" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/MiniPanel"
                            android:layout_marginStart="8dp">
                            <TextView
                                style="@style/MiniPanelLabel"
                                android:text="@string/label_upload" />
                            <TextView
                                android:id="@+id/tvUpload"
                                style="@style/MiniPanelValue"
                                android:text="@string/speed_na" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSpeedStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/speed_status_idle"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════ کارت ترافیک لحظه‌ای ═══════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout style="@style/CardHeader">

                        <androidx.appcompat.widget.AppCompatImageView
                            style="@style/CardIcon"
                            app:srcCompat="@drawable/ic_traffic" />

                        <TextView
                            style="@style/CardTitle"
                            android:text="@string/card_traffic_title" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/MiniPanel">
                            <TextView
                                style="@style/MiniPanelLabel"
                                android:text="@string/label_live_down" />
                            <TextView
                                android:id="@+id/tvLiveDown"
                                style="@style/MiniPanelValue"
                                android:text="@string/speed_na"
                                android:textColor="@color/sig_good" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/MiniPanel"
                            android:layout_marginStart="8dp">
                            <TextView
                                style="@style/MiniPanelLabel"
                                android:text="@string/label_live_up" />
                            <TextView
                                android:id="@+id/tvLiveUp"
                                style="@style/MiniPanelValue"
                                android:text="@string/speed_na"
                                android:textColor="@color/sig_mid" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════ کارت تاریخچه تست سرعت ═══════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout style="@style/CardHeader">

                        <androidx.appcompat.widget.AppCompatImageView
                            style="@style/CardIcon"
                            app:srcCompat="@drawable/ic_history" />

                        <TextView
                            style="@style/CardTitle"
                            android:text="@string/card_history_title" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/history_auto_saved"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <ir.netsignal.monitor.HistoryChartView
                        android:id="@+id/historyChart"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvHistoryCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/no_data"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvHistoryEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/history_empty"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/llHistoryList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearHistory"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_clear_history"
                        android:textColor="@color/text_secondary"
                        app:strokeColor="@color/stroke" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════ کارت اطلاعات دستگاه ═══════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout style="@style/CardHeader">

                        <androidx.appcompat.widget.AppCompatImageView
                            style="@style/CardIcon"
                            app:srcCompat="@drawable/ic_device" />

                        <TextView
                            style="@style/CardTitle"
                            android:text="@string/card_device_title" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_device_model" />
                        <TextView
                            android:id="@+id/tvDeviceModel"
                            style="@style/RowValue"
                            tools:text="Samsung SM-G991B" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_device_os" />
                        <TextView
                            android:id="@+id/tvDeviceOs"
                            style="@style/RowValue"
                            tools:text="اندروید ۱۴ (API ۳۴)" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_device_screen" />
                        <TextView
                            android:id="@+id/tvDeviceScreen"
                            style="@style/RowValue"
                            tools:text="۱۰۸۰ × ۲۴۰۰" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_device_battery" />
                        <TextView
                            android:id="@+id/tvDeviceBattery"
                            style="@style/RowValue"
                            tools:text="۸۵٪ — روی باتری" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_device_uptime" />
                        <TextView
                            android:id="@+id/tvDeviceUptime"
                            style="@style/RowValue"
                            tools:text="۲ ساعت و ۱۵ دقیقه" />
                    </LinearLayout>

                    <LinearLayout style="@style/InfoRow">
                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/label_device_cpu" />
                        <TextView
                            android:id="@+id/tvDeviceCpu"
                            style="@style/RowValue"
                            tools:text="ARM64" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/privacy_note"
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
